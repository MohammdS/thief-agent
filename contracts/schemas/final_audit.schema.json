{
  "$defs": {
    "ActionKind": {
      "description": "Distinguish a movement turn from Police barrier placement.",
      "enum": [
        "move",
        "barrier"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "AuditRecord": {
      "additionalProperties": false,
      "description": "Pair an immediate reveal with its final secret disclosure.",
      "properties": {
        "disclosure": {
          "$ref": "#/$defs/TurnDisclosure"
        },
        "reveal": {
          "$ref": "#/$defs/RevealedTurn"
        }
      },
      "required": [
        "reveal",
        "disclosure"
      ],
      "title": "AuditRecord",
      "type": "object"
    },
    "HintIntent": {
      "description": "Record truth or bluff intent for final audit only.",
      "enum": [
        "truth",
        "bluff"
      ],
      "title": "HintIntent",
      "type": "string"
    },
    "Move": {
      "description": "Enumerate the fixed physical action alphabet.",
      "enum": [
        "N",
        "S",
        "E",
        "W",
        "STAY"
      ],
      "title": "Move",
      "type": "string"
    },
    "PointConfig": {
      "additionalProperties": false,
      "description": "Represent a configured zero-based board coordinate.",
      "properties": {
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "PointConfig",
      "type": "object"
    },
    "RevealedTurn": {
      "additionalProperties": false,
      "description": "Store immediate public reveal data without nonce or intent.",
      "properties": {
        "barrier": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capture_claim": {
          "anyOf": [
            {
              "enum": [
                "overlap",
                "barrier",
                "imprisonment"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Claim"
        },
        "commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        },
        "hint": {
          "maxLength": 500,
          "title": "Hint",
          "type": "string"
        },
        "scent_heatmap": {
          "items": {
            "$ref": "#/$defs/ScentCell"
          },
          "title": "Scent Heatmap",
          "type": "array"
        },
        "turn_token": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "commitment",
        "turn_token",
        "scent_heatmap",
        "hint"
      ],
      "title": "RevealedTurn",
      "type": "object"
    },
    "Role": {
      "description": "Identify either autonomous peer role.",
      "enum": [
        "thief",
        "police"
      ],
      "title": "Role",
      "type": "string"
    },
    "ScentCell": {
      "additionalProperties": false,
      "description": "Publish one global board cell intensity without an agent position field.",
      "properties": {
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "intensity": {
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col",
        "intensity"
      ],
      "title": "ScentCell",
      "type": "object"
    },
    "TurnAction": {
      "additionalProperties": false,
      "description": "Represent exactly one physical turn action.",
      "properties": {
        "barrier": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "move": {
          "anyOf": [
            {
              "$ref": "#/$defs/Move"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "TurnAction",
      "type": "object"
    },
    "TurnDisclosure": {
      "additionalProperties": false,
      "description": "Add the secret nonce disclosed only during final audit.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TurnAction"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "hint": {
          "maxLength": 500,
          "title": "Hint",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/HintIntent"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nonce",
          "type": "string"
        },
        "prior_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior State Sha256",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "scent_heatmap": {
          "items": {
            "$ref": "#/$defs/ScentCell"
          },
          "title": "Scent Heatmap",
          "type": "array"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "subgame": {
          "minimum": 1,
          "title": "Subgame",
          "type": "integer"
        },
        "turn_token": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "game_id",
        "subgame",
        "step",
        "role",
        "turn_token",
        "prior_state_sha256",
        "action",
        "scent_heatmap",
        "hint",
        "intent",
        "nonce"
      ],
      "title": "TurnDisclosure",
      "type": "object"
    },
    "WireEnvelope": {
      "additionalProperties": false,
      "description": "Bind a request to one peer, configuration, state, and deadline.",
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "prior_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior State Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Role"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "subgame": {
          "minimum": 0,
          "title": "Subgame",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "subgame",
        "step",
        "sender",
        "message_id",
        "timestamp",
        "expires_at",
        "config_sha256",
        "prior_state_sha256"
      ],
      "title": "WireEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Carry final records only after the subgame series ends.",
  "properties": {
    "envelope": {
      "$ref": "#/$defs/WireEnvelope"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/AuditRecord"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "envelope",
    "records"
  ],
  "title": "FinalAuditRequest",
  "type": "object"
}
