{
  "$defs": {
    "Role": {
      "description": "Identify either autonomous peer role.",
      "enum": [
        "thief",
        "police"
      ],
      "title": "Role",
      "type": "string"
    },
    "WireEnvelope": {
      "additionalProperties": false,
      "description": "Bind a request to one peer, configuration, state, and deadline.",
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "prior_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior State Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Role"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "subgame": {
          "minimum": 0,
          "title": "Subgame",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "subgame",
        "step",
        "sender",
        "message_id",
        "timestamp",
        "expires_at",
        "config_sha256",
        "prior_state_sha256"
      ],
      "title": "WireEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Propose an independently calculated final result hash.",
  "properties": {
    "envelope": {
      "$ref": "#/$defs/WireEnvelope"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "phase": {
      "enum": [
        "subgame",
        "series"
      ],
      "title": "Phase",
      "type": "string"
    },
    "police_score": {
      "minimum": 0,
      "title": "Police Score",
      "type": "integer"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "sender_group_id": {
      "minLength": 1,
      "title": "Sender Group Id",
      "type": "string"
    },
    "thief_score": {
      "minimum": 0,
      "title": "Thief Score",
      "type": "integer"
    },
    "tokens_total": {
      "minimum": 0,
      "title": "Tokens Total",
      "type": "integer"
    }
  },
  "required": [
    "envelope",
    "phase",
    "sender_group_id",
    "result_sha256",
    "police_score",
    "thief_score",
    "tokens_total",
    "git_commit"
  ],
  "title": "ResultProposalRequest",
  "type": "object"
}
