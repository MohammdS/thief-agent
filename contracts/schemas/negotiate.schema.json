{
  "$defs": {
    "Role": {
      "description": "Identify either autonomous peer role.",
      "enum": [
        "thief",
        "police"
      ],
      "title": "Role",
      "type": "string"
    },
    "WireEnvelope": {
      "additionalProperties": false,
      "description": "Bind a request to one peer, configuration, state, and deadline.",
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "prior_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior State Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Role"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "subgame": {
          "minimum": 0,
          "title": "Subgame",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "subgame",
        "step",
        "sender",
        "message_id",
        "timestamp",
        "expires_at",
        "config_sha256",
        "prior_state_sha256"
      ],
      "title": "WireEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Propose the locked contract and series parameters.",
  "properties": {
    "contract_version": {
      "const": "1.3",
      "title": "Contract Version",
      "type": "string"
    },
    "counted": {
      "title": "Counted",
      "type": "boolean"
    },
    "envelope": {
      "$ref": "#/$defs/WireEnvelope"
    },
    "game_uid": {
      "minLength": 1,
      "title": "Game Uid",
      "type": "string"
    },
    "sender_group_id": {
      "minLength": 1,
      "title": "Sender Group Id",
      "type": "string"
    },
    "series_started_at": {
      "format": "date-time",
      "title": "Series Started At",
      "type": "string"
    },
    "subgames": {
      "minimum": 1,
      "title": "Subgames",
      "type": "integer"
    }
  },
  "required": [
    "envelope",
    "contract_version",
    "counted",
    "subgames",
    "sender_group_id",
    "game_uid",
    "series_started_at"
  ],
  "title": "NegotiationRequest",
  "type": "object"
}
