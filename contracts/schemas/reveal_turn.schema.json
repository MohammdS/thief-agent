{
  "$defs": {
    "PointConfig": {
      "additionalProperties": false,
      "description": "Represent a configured zero-based board coordinate.",
      "properties": {
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "PointConfig",
      "type": "object"
    },
    "Role": {
      "description": "Identify either autonomous peer role.",
      "enum": [
        "thief",
        "police"
      ],
      "title": "Role",
      "type": "string"
    },
    "ScentCell": {
      "additionalProperties": false,
      "description": "Publish one global board cell intensity without an agent position field.",
      "properties": {
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "intensity": {
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col",
        "intensity"
      ],
      "title": "ScentCell",
      "type": "object"
    },
    "WireEnvelope": {
      "additionalProperties": false,
      "description": "Bind a request to one peer, configuration, state, and deadline.",
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "prior_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior State Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Role"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "subgame": {
          "minimum": 0,
          "title": "Subgame",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "subgame",
        "step",
        "sender",
        "message_id",
        "timestamp",
        "expires_at",
        "config_sha256",
        "prior_state_sha256"
      ],
      "title": "WireEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reveal observations and transfer the turn while withholding the action.",
  "properties": {
    "barrier": {
      "anyOf": [
        {
          "$ref": "#/$defs/PointConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capture_claim": {
      "anyOf": [
        {
          "enum": [
            "overlap",
            "barrier",
            "imprisonment"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture Claim"
    },
    "envelope": {
      "$ref": "#/$defs/WireEnvelope"
    },
    "hint": {
      "maxLength": 500,
      "title": "Hint",
      "type": "string"
    },
    "scent_heatmap": {
      "items": {
        "$ref": "#/$defs/ScentCell"
      },
      "title": "Scent Heatmap",
      "type": "array"
    },
    "turn_token": {
      "$ref": "#/$defs/Role"
    }
  },
  "required": [
    "envelope",
    "turn_token",
    "scent_heatmap",
    "hint"
  ],
  "title": "RevealTurnRequest",
  "type": "object"
}
